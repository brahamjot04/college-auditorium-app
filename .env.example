# ==============================================================================
# COLLEGE AUDITORIUM EVENT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' for local development:
#    cp .env.example .env
# 2. NEVER commit '.env' or any file containing active tokens to Git!
# 3. For production, add these variables in your Vercel Project Settings:
#    Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side Environment Variables (Vercel Serverless Functions / Backend)
# ------------------------------------------------------------------------------
# CRITICAL SECURITY NOTE:
# Variables WITHOUT the 'VITE_' prefix are strictly server-side and are NEVER
# bundled into the client browser JavaScript. Use these for your GitHub token.

# Fine-grained GitHub Personal Access Token (PAT)
# Required permissions: 'Contents: Read and write' on the assets repository ONLY.
GITHUB_TOKEN=github_pat_your_fine_grained_token_here

# GitHub repository details for storing auditorium visual assets & logos
GITHUB_USERNAME=brahamjot04
GITHUB_REPO=event-report-cc-app-data
GITHUB_BRANCH=main


# ------------------------------------------------------------------------------
# 2. Client-Side Environment Variables (Vite Frontend)
# ------------------------------------------------------------------------------
# SECURITY NOTE:
# Any variable starting with 'VITE_' WILL BE STATICALLY EMBEDDED into the public
# browser JavaScript bundle. Do NOT put private passwords or secret tokens here!

# EmailJS Service Credentials (Used for digital gate pass ticket emails)
VITE_EMAILJS_SERVICE_ID=service_your_service_id
VITE_EMAILJS_TEMPLATE_ID=template_your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# GitHub Repository Information for Client-Side Asset Links
VITE_GITHUB_USERNAME=brahamjot04
VITE_GITHUB_REPO=event-report-cc-app-data
VITE_GITHUB_BRANCH=main

# ------------------------------------------------------------------------------
# 3. Optional Firebase Configuration Overrides
# ------------------------------------------------------------------------------
# (Uncomment if you wish to externalize credentials from src/firebase.js)
# VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
# VITE_FIREBASE_AUTH_DOMAIN=theatre-event-gndec.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=theatre-event-gndec
# VITE_FIREBASE_STORAGE_BUCKET=theatre-event-gndec.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=232017137108
# VITE_FIREBASE_APP_ID=1:232017137108:web:your_app_id
