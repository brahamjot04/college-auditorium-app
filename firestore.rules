rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'superadmin';
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' ||
        isSuperAdmin()
      );
    }

    function isApprovedStaff() {
      return isSignedIn() && (
        getUserData().role == 'user' ||
        isAdmin()
      );
    }

    // 1. Users collection
    match /users/{userId} {
      // Direct reading of own profile:
      // Any user can read their own profile (by UID or matching verified email); Admins can read all profiles.
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
        isAdmin()
      );

      // Admins can list all users; Users can query their own email
      allow list: if isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );

      // Creation:
      // Strictly Admins can create profiles with 'user' or 'admin' roles (cannot create superadmin).
      // Verified users can link/create their own UID profile with 'user' role matching their auth email.
      allow create: if isSignedIn() && (
        (isAdmin() && request.resource.data.role in ['user', 'admin']) ||
        (
          request.auth.uid == userId &&
          request.auth.token.email != null &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.role == 'user'
        )
      );

      // Updates:
      // Super Admin can update any profile and any role.
      // Regular Admins can manage non-admin accounts and promote up to 'admin' (cannot touch existing admins or assign superadmin).
      // Users can update their own profile fields, but CANNOT alter their assigned role.
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          isAdmin() &&
          resource.data.role != 'admin' &&
          resource.data.role != 'superadmin' &&
          request.resource.data.role != 'superadmin'
        ) ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role
        )
      );

      // Only Super Admin can delete user documents
      allow delete: if isSuperAdmin();
    }

    // 2. Events collection
    match /events/{eventId} {
      // Anyone can read event details (needed for public gate passes and staff views)
      allow read: if true;

      // Both Admins and Super Admins can create, edit, archive, or delete events
      allow write: if isAdmin();

      // 3. Seats subcollection
      match /seats/{seatId} {
        // Public pass lookup: individual get allowed for attendees viewing their ticket pass
        allow get: if true;

        // Bulk listing: ONLY approved Staff and Admins can query/list all seats (prevents mass PII scraping)
        allow list: if isApprovedStaff();

        // Staff and Admins can book seats and check in attendees
        allow create, update: if isApprovedStaff();

        // Only Admins can delete (release/unblock) seats
        allow delete: if isAdmin();
      }

      // 4. Audit Activity Logs subcollection
      match /activityLogs/{logId} {
        // Staff can record check-in and booking activity
        allow create: if isApprovedStaff();

        // Only Admins can read, update, or delete audit logs
        allow read, update, delete: if isAdmin();
      }
    }

    // 5. System Settings collection (EmailJS credentials & global branding defaults)
    match /system_settings/{settingId} {
      // Protect credentials: only approved Staff & Admins can read system settings
      allow read: if isApprovedStaff();

      // Only Admins and Super Admins can update system settings
      allow write: if isAdmin();
    }
  }
}
